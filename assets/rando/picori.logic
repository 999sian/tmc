# Picori native randomizer rules, version 1.
# Authored from the game room tables, item ids, script reward hooks, and flag banks.
# Three-part addresses are native area-room-ordinal for chests and
# area-room-local flag for flagged ground pickups. The ROM offsets below
# document the USA source records; the runtime checks the active ROM.
!name - Picori native rules 1
!version - 1
!dropdown - Main Settings - Setting - Logic - ACCESSIBILITY - Reachability - Required completion target - ACCESS_BEATABLE - Beat game - ACCESS_BEATABLE - Reach the final boss
!dropdown - Main Settings - Setting - World - DOJO - Dojo rewards - Shuffle or retain sword lessons - DOJOANY - Shuffled - DOJOANY - Lessons enter the item pool - Original - DOJOVANILLA - Lessons stay with their teachers
!dropdown - Main Settings - Setting - Items - ITEM_POOL - Item pool - Select the amount of optional equipment and health - ITEM_POOL_NORMAL - Balanced - ITEM_POOL_NORMAL - Standard extras - Lean - ITEM_POOL_RIP - Fewer optional rewards - Plentiful - ITEM_POOL_PLENTIFUL - More optional rewards
!flag - Main Settings - Setting - Items - START_SMITH_SWORD - Start with Smith Sword - Grant the Smith Sword on a new file - true
!flag - Main Settings - Setting - Items - RUPEEMANIA - Extra ground checks - Shuffle additional flagged pickups

# The starting sword is a real new-file grant; model it as a fixed virtual
# check so assumed fill cannot hide a required item behind sword access.
!ifdef - START_SMITH_SWORD
StartSword:NoSpoiler; Unshuffled; ; ; Items.SmithSword
!endif

# Progression items. These names map to the engine item ids, not ROM writes.
!ifndef - START_SMITH_SWORD
Items.SmithSword; Major
!endif
