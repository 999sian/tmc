# Item-pool profiles alter optional rewards without changing the goal kit.
!ifdef - ITEM_POOL_RIP
Items.HeartPiece:6; Minor
Items.Rupee50:10; Minor
Items.Shells.0x32:4; Minor
Items.Kinstone.GreenC:5; Minor
Items.Kinstone.RedW:2; Minor
Items.Kinstone.BlueL:2; Minor
!else
!ifdef - ITEM_POOL_PLENTIFUL
Items.HeartPiece:30; Minor
Items.HeartContainer:8; Minor
Items.Rupee100:12; Minor
Items.Rupee50:14; Minor
Items.Shells.0x32:10; Minor
Items.Kinstone.GreenC:10; Minor
Items.Kinstone.RedW:5; Minor
Items.Kinstone.RedV:5; Minor
Items.Kinstone.RedE:5; Minor
Items.Kinstone.BlueL:5; Minor
Items.Kinstone.BlueS:5; Minor
Items.Bombs10:7; Minor
Items.Arrows10:7; Minor
!else
Items.HeartPiece:18; Minor
Items.HeartContainer:4; Minor
Items.Rupee100:6; Minor
Items.Rupee50:10; Minor
Items.Shells.0x32:7; Minor
Items.Kinstone.GreenC:7; Minor
Items.Kinstone.RedW:3; Minor
Items.Kinstone.RedV:3; Minor
Items.Kinstone.RedE:3; Minor
Items.Kinstone.BlueL:3; Minor
Items.Kinstone.BlueS:3; Minor
Items.Bombs10:4; Minor
Items.Arrows10:4; Minor
!endif
!endif
Items.Rupee5; Filler
Items.Rupee20; Filler
Items.Rupee50; Filler
Items.Shells30; Filler
Items.Heart; Filler
Items.Bombs5; Filler
Items.Arrows5; Filler

# Region gates are conservative item requirements. They deliberately
# leave shortcuts out until the native routes and flags have been tested.
